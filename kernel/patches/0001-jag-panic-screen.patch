--- a/kernel/panic.c
+++ b/kernel/panic.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 #include <linux/kernel.h>
 #include <linux/panic_notifier.h>
+#include <linux/console.h>
 #include <linux/delay.h>
 #include <linux/init.h>
 #include <linux/printk.h>
@@ -77,6 +78,42 @@ static void panic_print_sys_info(bool console_flush)
 		print_memory_info();
 }
 
+static void jag_panic_screen(const char *msg, const char *reason)
+{
+	console_flush_on_panic(CONSOLE_FLUSH_PENDING);
+
+	pr_emerg("\n");
+	pr_emerg("##############################################\n");
+	pr_emerg("#                                            #\n");
+	pr_emerg("#         ( x _ x )                         #\n");
+	pr_emerg("#                                            #\n");
+	pr_emerg("#   JAG Linux ran into a problem            #\n");
+	pr_emerg("#                                            #\n");
+	pr_emerg("#   Error: %-34s#\n", msg);
+	pr_emerg("#                                            #\n");
+	pr_emerg("#   Caused by: %-30s#\n", reason ? reason : "unknown");
+	pr_emerg("#                                            #\n");
+	pr_emerg("#   The system will reboot in 30 seconds    #\n");
+	pr_emerg("#                                            #\n");
+	pr_emerg("##############################################\n");
+	pr_emerg("\n");
+}
+
 void panic(const char *fmt, ...)
 {
 	static char buf[1024];
@@ -130,6 +167,9 @@ void panic(const char *fmt, ...)
 	bust_spinlocks(0);
 	flags = console_lock_spinning_enable();
 
+	/* JAG Linux custom panic screen */
+	jag_panic_screen(buf, NULL);
+
 	panic_print_sys_info(false);
